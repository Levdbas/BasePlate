<!DOCTYPE html>
<html class="app" {{ site.language_attributes }}>
    {% include 'partials/head.twig' %}

    <body class="{{ body_class }}">
        {% do action('wp_body_open') %}
        {% include 'partials/header.twig' %}

        <main class="main">
            {% block content %}

            {% endblock %}
        </main>

        {% include 'partials/footer.twig' %}

        {% do action('wp_footer') %}
        {% do action('get_footer') %}
    </body>
</html>
